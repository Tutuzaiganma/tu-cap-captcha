{
    "name": "tu/cap-captcha",
    "description": "Verification plugin used to intercept frequent or bot-like operations such as registration, login, posting, and replying.",
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "tu",
            "email": "hzhwb040719@163.com"
        }
    ],
    "require": {
        "flarum/core": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Tu\\CapCaptcha\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Cap Captcha",
            "icon": {
                "name": "fas fa-shield-alt",
                "color": "#fff",
                "backgroundColor": "#007bff"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "css": true,
                "locale": true,
                "git-hooks": true,
                "github-actions": true
            }
        }
    }
}
